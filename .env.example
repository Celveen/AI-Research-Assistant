# ====== DeepSeek API ======
# 在 DeepSeek 开放平台创建 API Key 后填入此处
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# ====== 文档处理 ======
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ====== 检索 ======
RETRIEVER_TOP_K=5

# 自适应检索：先召回 FETCH_K 大池，再按相似度阈值动态保留 [MIN_K, MAX_K] 条
RETRIEVER_ADAPTIVE=true
RETRIEVER_FETCH_K=20
RETRIEVER_SCORE_THRESHOLD=0.6
RETRIEVER_MIN_K=3
RETRIEVER_MAX_K=10

# ====== 生成 ======
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=20480

# ====== 嵌入模型 ======
# 默认使用 ChromaDB 内置的轻量本地 Embedding (sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ====== 路径 ======
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore
LOG_DIR=logs

# ====== 服务端口 ======
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
