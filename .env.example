# ====== DeepSeek API ======
# 在 DeepSeek 开放平台创建 API Key 后填入此处
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# ====== 文档处理 ======
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ====== 检索 ======
RETRIEVER_TOP_K=5

# 自适应检索：先召回 FETCH_K 大池，再按相似度阈值动态保留 [MIN_K, MAX_K] 条
RETRIEVER_ADAPTIVE=true
RETRIEVER_FETCH_K=20
RETRIEVER_SCORE_THRESHOLD=0.75
RETRIEVER_MIN_K=3
RETRIEVER_MAX_K=10

# ====== 生成 ======
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=20480

# ====== 嵌入模型 ======
# 基于 fastembed 的 ONNX 本地嵌入（无需 torch）。默认中英双语模型，约 220MB，首次运行自动下载。
# 可选更小/更大：BAAI/bge-small-zh-v1.5(中文) / intfloat/multilingual-e5-large(双语2.2GB)
# 注意：换模型后旧向量不兼容，需清空 data/vectorstore/ 重新入库。
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ====== 路径 ======
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore
LOG_DIR=logs

# ====== 服务端口 ======
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
